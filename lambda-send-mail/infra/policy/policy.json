{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::InvoiceBucket",
        "arn:aws:s3:::InvoiceBucket/*"
      ]
    },
    {
        "Effect": "Allow",
        "Action": [
          "ses:SendRawEmail"
        ],
        "Resource": "*"
    }
  ]
}